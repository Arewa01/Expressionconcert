# Forms (contact, choir, school of music, newsletter) are emailed through Resend: https://resend.com
RESEND_API_KEY=
FORMS_TO_EMAIL=hello@expressionconcert.com
# Must be an address on a domain verified in Resend
FORMS_FROM_EMAIL=Expression Concert website <forms@expressionconcert.com>

# Donations go through Stripe Checkout: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Used to build the return links after payment
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gallery: Google Drive API key (Google Cloud console > APIs & Services > Credentials, with the Drive API enabled).
# Each album folder must be shared as "Anyone with the link: Viewer". Folder IDs live in src/content/gallery.ts.
GOOGLE_DRIVE_API_KEY=
